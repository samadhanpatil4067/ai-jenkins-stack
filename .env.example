# ── ARIA Stack — Environment Variables ───────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — never commit real keys to source control.
# ─────────────────────────────────────────────────────────────

# ── LLM Provider (required) ──────────────────────────────────
# OpenAI:
LLM_API_KEY=sk-your-openai-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Azure OpenAI (uncomment and fill):
# LLM_API_KEY=your-azure-key
# LLM_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT
# LLM_MODEL=gpt-4o

# Ollama local (uncomment — no API key needed):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3

# Groq (fast + cheap, great for dev):
# LLM_API_KEY=gsk_your-groq-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama3-70b-8192

# ── LLM Tuning ───────────────────────────────────────────────
LLM_TEMPERATURE=0.1   # low = more deterministic, good for classification

# ── GitHub (for auto-filing issues) ──────────────────────────
# Create at: github.com/settings/tokens/new
# Scopes needed: repo (issues + contents)
GITHUB_TOKEN=ghp_your-token-here

# ── Slack (optional — for failure notifications) ──────────────
# SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
