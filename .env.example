# ================================================================
# ARIA Stack — Environment Variables
# ================================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored. Never commit real values to source control.
# ================================================================

# ── Jenkins (your existing local instance) ───────────────────
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_TOKEN=your-jenkins-api-token
# Generate: Jenkins → top-right username → Configure → API Token → Add new Token

# ── GitHub ────────────────────────────────────────────────────
# Repo this pipeline will watch:
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=aria-stack
GITHUB_REPO_URL=https://github.com/your-github-username/aria-stack.git
GITHUB_DEFAULT_BRANCH=main

# GitHub token — create at: github.com/settings/tokens/new
# Scopes needed: repo (full) + admin:repo_hook (for webhook setup)
GITHUB_TOKEN=ghp_your-token-here

# ── LLM Provider ─────────────────────────────────────────────
# OpenAI (default):
LLM_API_KEY=dummy
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:7b

# Groq (fast + cheap for dev — uncomment to use):
# LLM_API_KEY=gsk_your-groq-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama3-70b-8192

# Azure OpenAI (uncomment to use):
# LLM_API_KEY=your-azure-key
# LLM_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOY
# LLM_MODEL=gpt-4o

# Ollama local (free, no key — uncomment to use):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3

LLM_TEMPERATURE=0.1

# ── Service URLs ──────────────────────────────────────────────
# Jenkins on host + sidecar in Docker → localhost
AI_SIDECAR_URL=http://localhost:8000
PUSHGATEWAY_URL=http://localhost:9091

# ── Docker registry ───────────────────────────────────────────
DOCKER_REGISTRY=registry.company.io
# Docker Hub alternative: DOCKER_REGISTRY=docker.io/yourusername

# ── Kubernetes (leave blank to skip k8s deploy stage) ─────────
KUBE_NAMESPACE=production

# ── Service ports (change if defaults conflict) ───────────────
AI_SIDECAR_PORT=8000
PROMETHEUS_PORT=9090
PUSHGATEWAY_PORT=9091
GRAFANA_PORT=3000

# ── Grafana credentials ───────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Slack (optional) ─────────────────────────────────────────
# SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
